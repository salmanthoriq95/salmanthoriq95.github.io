---
import { experienceContent, getExperienceId } from "../data/experience";
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroScrollCue from "./HeroScrollCue.astro";
import SectionHeading from "./SectionHeading.astro";

const copy = experienceContent;
---

<SiteLayout
  title={copy.meta.title}
  description={copy.meta.description}
>
  <main>
    <section class="experience-hero" aria-labelledby="experience-title">
      <div class="hero-copy">
        <h1 id="experience-title">
          {copy.hero.title}<span aria-hidden="true">.</span>
        </h1>
        <p>{copy.hero.intro}</p>
      </div>

      <HeroScrollCue href="#experience-timeline" label={copy.hero.range} />
    </section>

    <section id="experience-timeline" class="timeline-section" aria-labelledby="timeline-title">
      <SectionHeading
        label={copy.section.label}
        title={copy.section.title}
        intro={copy.section.intro}
        titleId="timeline-title"
      />

      <div class="timeline">
        {copy.entries.map((entry, index) => (
          <details
            id={getExperienceId(entry.company)}
            open={index === 0}
            data-smooth-details
          >
            <summary>
              <span class="summary-title">
                <strong>{entry.company}</strong>
                <span>{entry.role}</span>
              </span>
              <span class="period">{entry.period}</span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>

            <div class="panel">
              <section class="technology-list">
                <ul>
                  {entry.technologies.map((technology) => <li>{technology}</li>)}
                </ul>
              </section>

              <div class="panel-content">
                <div class="panel-meta">
                  <p>
                    <span>{copy.labels.industry}</span>
                    {entry.industry}
                  </p>
                  {entry.location && (
                    <p>
                      <span>{copy.labels.location}</span>
                      {entry.location}
                    </p>
                  )}
                </div>

                <div class="overview">
                  {entry.summary.map((paragraph) => <p>{paragraph}</p>)}
                </div>

                <section class="contributions">
                  <h3>{copy.labels.contributions}</h3>
                  <ul>
                    {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </section>
              </div>

              <section class="selected-work">
                <h3>{copy.labels.selectedWork}</h3>
                <div
                  class="project-carousel"
                  data-horizontal-drag
                  role="region"
                  aria-label={`${entry.company}: ${copy.labels.selectedWork}`}
                  tabindex="0"
                >
                  <div class="project-list">
                    {entry.projects.map((project) => (
                      <article>
                        <h4>{project.title}</h4>
                        <p>{project.description}</p>
                      </article>
                    ))}
                  </div>
                </div>
              </section>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-inner">
        <p class="eyebrow"><span></span>{copy.closing.label}</p>
        <div class="closing-grid">
          <h2 id="closing-title">{copy.closing.title}</h2>
          <div class="closing-copy">
            {copy.closing.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>
  </main>

</SiteLayout>

<style>
  .experience-hero,
  .timeline,
  .closing-inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .experience-hero {
    display: grid;
    min-height: min(42rem, calc(100svh - 4.25rem));
    padding: 3.5rem var(--page-pad) 2rem;
    grid-template-rows: 1fr auto;
  }

  .hero-copy {
    align-self: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 15vw, 6rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.085em;
  }

  h1 span {
    color: var(--accent);
  }

  .hero-copy > p {
    max-width: 28rem;
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .timeline-section {
    padding: 5rem var(--page-pad);
    background: #fff;
  }

  .timeline {
    display: grid;
    gap: 0.65rem;
  }

  details {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper);
    scroll-margin-top: 1rem;
    color: var(--ink);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease);
  }

  details[open] {
    background: var(--ink);
    color: #fff;
  }

  summary {
    display: grid;
    align-items: center;
    min-height: 6.5rem;
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    grid-template-columns: minmax(0, 1fr) 2rem;
    gap: 0.75rem 0;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .summary-title {
    display: grid;
    min-width: 0;
  }

  .summary-title strong {
    overflow-wrap: anywhere;
    font-size: 1.12rem;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .summary-title > span {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.75rem;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  details[open] .summary-title > span {
    color: #bdbdbd;
  }

  .period {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.65rem;
    line-height: 1.35;
    grid-column: 1;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  details[open] .period {
    color: #bdbdbd;
  }

  .toggle {
    position: relative;
    width: 1.8rem;
    height: 1.8rem;
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    border-radius: 50%;
    background: #fff;
  }

  .toggle::before,
  .toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.65rem;
    height: 1px;
    background: var(--ink);
    content: "";
    transform: translate(-50%, -50%);
  }

  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  details[open] .toggle {
    background: var(--accent);
  }

  details[open] .toggle::before,
  details[open] .toggle::after {
    background: #fff;
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%);
  }

  .panel {
    padding: 0 1rem 1.25rem;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  details[open]:not([data-closing]) .panel {
    opacity: 1;
    transform: translateY(0);
  }

  .panel-content {
    width: calc(100% - clamp(1rem, 8vw, 4rem));
    max-width: 44rem;
    margin-inline: auto;
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.75rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .panel-meta p {
    margin: 0;
    color: #d0d0d0;
    font-size: 0.7rem;
  }

  .panel-meta span {
    display: block;
    margin-bottom: 0.2rem;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .overview {
    display: grid;
    width: 100%;
    gap: 0.75rem;
    padding: 0.5rem 0 3rem;
  }

  .overview p,
  .closing-copy p {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.65;
  }

  h3 {
    margin: 0 0 1rem;
    color: #fff;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contributions ul {
    display: grid;
    gap: 0;
    margin: 0 0 0 clamp(0.75rem, 3vw, 1.75rem);
    padding: 0;
    list-style: none;
  }

  .contributions li {
    position: relative;
    padding: 0.8rem 0 0.8rem 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    color: #d0d0d0;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .contributions li::before {
    position: absolute;
    top: 1.17rem;
    left: 0;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  .selected-work {
    margin-top: 2.5rem;
  }

  .project-carousel {
    width: 100%;
    overflow-x: auto;
    cursor: grab;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
  }

  .project-carousel::-webkit-scrollbar {
    display: none;
  }

  .project-carousel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.25rem;
  }

  .project-carousel.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .project-list {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  .project-list article {
    width: min(76vw, 22rem);
    min-height: 12rem;
    padding: 1.15rem;
    flex: 0 0 auto;
    border-radius: 0.75rem;
    background: #1a1a1a;
    scroll-snap-align: start;
  }

  h4 {
    margin: 0 0 0.5rem;
    color: var(--electric);
    font-size: 0.9rem;
    letter-spacing: -0.02em;
  }

  .project-list p {
    margin: 0;
    color: #bdbdbd;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .technology-list {
    padding: 0 0 1.5rem;
  }

  .technology-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: 0.38rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: #d0d0d0;
    font-size: 0.63rem;
  }

  .closing {
    padding: 5rem var(--page-pad);
    background: var(--accent);
  }

  .closing .eyebrow {
    color: rgba(10, 10, 10, 0.68);
  }

  .closing .eyebrow > span {
    background: var(--ink);
  }

  .closing-grid {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .closing h2 {
    margin: 0;
    font-size: clamp(2.8rem, 13vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .closing-copy {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .experience-hero {
      min-height: min(46rem, calc(100vh - 4.8rem));
      padding-top: 4.5rem;
      padding-right: 0;
      padding-bottom: 2.5rem;
      padding-left: 0;
    }

    .hero-copy {
      display: grid;
      align-items: end;
      grid-template-columns: minmax(0, 1.75fr) minmax(14rem, 0.75fr);
      gap: 2.5rem;
    }

    h1 {
      font-size: clamp(5rem, 7vw, 6rem);
    }

    .hero-copy > p {
      margin: 0 0 0.3rem;
    }

    .timeline-section,
    .closing {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }

    summary {
      min-height: 6.5rem;
      padding: 1.25rem 1.4rem;
      grid-template-columns: minmax(0, 1fr) minmax(10rem, auto) 2rem;
      gap: 1.5rem;
    }

    .summary-title strong {
      font-size: 1.35rem;
    }

    .period {
      margin: 0;
      grid-column: 2;
      text-align: right;
    }

    .toggle {
      grid-column: 3;
      grid-row: 1;
    }

    .panel {
      padding: 0 1.4rem 1.5rem;
    }

    .panel-meta {
      padding-top: 1.25rem;
    }

    .closing-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
      gap: 3rem;
    }
  }

  @media (min-width: 56rem) {
    .timeline-section,
    .closing {
      padding-right: max(var(--page-pad), calc((100vw - var(--content-width)) / 2));
      padding-left: max(var(--page-pad), calc((100vw - var(--content-width)) / 2));
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const openTargetExperience = () => {
    const targetId = decodeURIComponent(window.location.hash.slice(1));
    const target = targetId
      ? document.getElementById(targetId)
      : undefined;

    if (target instanceof HTMLDetailsElement) {
      document.querySelectorAll<HTMLDetailsElement>(".timeline > details").forEach((details) => {
        details.open = details === target;
        delete details.dataset.closing;
        details.style.removeProperty("height");
        details.style.removeProperty("overflow");
      });

      window.requestAnimationFrame(() => {
        target.scrollIntoView({
          behavior: reduceMotion.matches ? "auto" : "smooth",
          block: "start",
        });
      });
    }
  };

  openTargetExperience();
  window.addEventListener("hashchange", openTargetExperience);
</script>

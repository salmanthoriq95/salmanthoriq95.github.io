---
import {
  defaultLocale,
  getLocalizedPath,
  localeNames,
  supportedLocales,
  type Locale,
} from "../i18n";
import { ui } from "../i18n/ui";
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = ui[locale].footer;
const year = new Date().getFullYear();
const emailHref = `mailto:${site.contact.email}`;
---

<footer id="contact" class="site-footer">
  <div class="footer-meta">
    <div>
      <p class="label" data-footer-copy="basedIn">{copy.basedIn}</p>
      <p>{site.location.country}<br />{site.location.timezone}</p>
    </div>

    <div>
      <p class="label" data-footer-copy="contact">{copy.contact}</p>
      <a href={emailHref}>{site.contact.email}</a>
    </div>

    <div>
      <p class="label" data-footer-copy="elsewhere">{copy.elsewhere}</p>
      <SocialLinks />
    </div>

    <div class="language-picker">
      <p class="label" data-footer-copy="language">{copy.language}</p>
      <details data-smooth-details>
        <summary>
          <span data-footer-language-name>{copy.languageName}</span>
          <span class="language-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="language-options" aria-label={ui[locale].language.label}>
          {supportedLocales.map((supportedLocale) => (
            <a
              href={getLocalizedPath(supportedLocale, Astro.url.pathname)}
              lang={supportedLocale}
              hreflang={supportedLocale}
              aria-label={localeNames[supportedLocale]}
              aria-current={supportedLocale === locale ? "page" : undefined}
              data-locale={supportedLocale}
            >
              {ui[supportedLocale].footer.languageName}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>

  <a class="contact-word" href={emailHref} aria-label={copy.emailLabel} data-footer-contact-word>
    {copy.contactWord}
  </a>
  <p class="copyright" data-footer-copyright>© {year} {site.author.shortName} · {copy.archive}</p>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    padding: 3.5rem var(--page-pad) 1.75rem;
    background: var(--night);
    color: #f7f2f7;
  }

  .footer-meta {
    display: grid;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  p {
    margin: 0;
    color: #c9bdca;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .label {
    margin-bottom: 0.55rem;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-meta a {
    display: inline-block;
    color: #c9bdca;
    font-size: 0.76rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2rem;
    transition:
      color var(--motion-duration) var(--motion-ease),
      text-decoration-color var(--motion-duration) var(--motion-ease);
  }

  .footer-meta a:hover,
  .footer-meta a:focus-visible {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .language-picker details {
    max-width: 16rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .language-picker summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.55rem;
    cursor: pointer;
    color: #c9bdca;
    font-size: 0.76rem;
    list-style: none;
    text-transform: uppercase;
  }

  .language-picker summary::-webkit-details-marker {
    display: none;
  }

  .language-picker summary:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 0.25rem;
  }

  .language-toggle {
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .language-picker details[open] .language-toggle {
    transform: rotate(180deg);
  }

  .language-options {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.15rem 0 0.65rem;
  }

  .language-options a {
    width: 100%;
    padding: 0.45rem 0.55rem;
    border-radius: 0.35rem;
    text-transform: uppercase;
  }

  .language-options a:hover,
  .language-options a:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    text-decoration-color: transparent;
  }

  .language-options a[aria-current="page"] {
    color: #fff;
    text-decoration-color: var(--electric);
  }

  .contact-word {
    display: block;
    width: 100%;
    padding-bottom: 0.12em;
    color: var(--electric);
    font-family: "Arial Black", Arial, Helvetica, sans-serif;
    font-size: clamp(3.85rem, 20vw, 16rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.09em;
    text-align: center;
    text-transform: uppercase;
  }

  .copyright {
    margin-top: 1.25rem;
    text-align: center;
  }

  @media (min-width: 36rem) {
    .footer-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .site-footer {
      padding-top: 5rem;
    }

    .footer-meta {
      grid-template-columns: 0.8fr 1.2fr 0.8fr 1fr;
      padding-bottom: 5.5rem;
    }

  }
</style>

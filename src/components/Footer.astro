---
import { site } from "../data/site";
import { ui } from "../data/ui";
import SocialLinks from "./SocialLinks.astro";

const copy = ui.footer;
const year = new Date().getFullYear();
const emailHref = `mailto:${site.contact.email}`;
---

<footer id="contact" class="site-footer">
  <div class="footer-meta">
    <div>
      <p class="label">{copy.basedIn}</p>
      <p>{site.location.country}<br />{site.location.timezone}</p>
    </div>

    <div>
      <p class="label">{copy.contact}</p>
      <a href={emailHref}>{site.contact.email}</a>
    </div>

    <div>
      <p class="label">{copy.resume}</p>
      <a href={site.resume.href} download={site.resume.downloadName}>
        {copy.downloadResume}
      </a>
    </div>

    <div>
      <p class="label">{copy.elsewhere}</p>
      <SocialLinks />
    </div>
  </div>

  <a class="contact-word" href={emailHref} aria-label={copy.emailLabel}>
    {copy.contactWord}<span class="brand-accent">.</span>
  </a>
  <p class="copyright">© {year} · {copy.archive}</p>
</footer>

<style>
  .brand-accent {
    color: var(--accent);
  }
  .site-footer {
    overflow: hidden;
    padding: 3.5rem var(--page-pad) 1.75rem;
    background: var(--night);
    color: #f7f2f7;
  }

  .footer-meta {
    display: grid;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  p {
    margin: 0;
    color: #c9bdca;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .label {
    margin-bottom: 0.55rem;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-meta a {
    display: inline-block;
    color: #c9bdca;
    font-size: 0.76rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2rem;
    transition:
      color var(--motion-duration) var(--motion-ease),
      text-decoration-color var(--motion-duration) var(--motion-ease);
  }

  .footer-meta a:hover,
  .footer-meta a:focus-visible {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .contact-word {
    display: block;
    width: 100%;
    padding-bottom: 0.12em;
    color: var(--electric);
    font-family: "Arial Black", Arial, Helvetica, sans-serif;
    font-size: clamp(3.85rem, 20vw, 16rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.09em;
    text-align: center;
    text-transform: uppercase;
  }

  .copyright {
    margin-top: 1.25rem;
    text-align: center;
  }

  @media (min-width: 36rem) {
    .footer-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .footer-meta {
      grid-template-columns: 0.8fr minmax(10rem, 1.2fr) 0.8fr minmax(18rem, 1.2fr);
      align-items: start;
      padding-bottom: 5.5rem;
    }
  }

  @media (min-width: 64rem) {
    .site-footer {
      padding-top: 5rem;
    }
  }
</style>

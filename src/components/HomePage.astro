---
import { defaultLocale, getLocalizedPath, type Locale } from "../i18n";
import { ui } from "../i18n/ui";
import { experienceContent, getExperienceId } from "../data/experience";
import { projects } from "../data/projects";
import { site } from "../data/site";
import {
  formatWritingDate,
  getPublishedWriting,
  getWritingPath,
} from "../lib/writing";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import HeroScrollCue from "./HeroScrollCue.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = ui[locale];
const experiences = experienceContent[locale].entries;
const experienceHref = getLocalizedPath(locale, "/experience");
const projectsHref = getLocalizedPath(locale, "/projects");
const writingHref = getLocalizedPath(locale, "/writing");
const writingEntries = (await getPublishedWriting()).slice(0, 8);
const sections = copy.home.sections.map((section) => ({
  ...section,
  href: getLocalizedPath(locale, section.path),
}));
const defaultGreeting = site.greetings[0];
---

<BaseLayout
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
>
  <Header locale={locale} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-heading">
        <h1 id="hero-title" aria-label={`${defaultGreeting}.`}>
          <span
            class="greeting"
            data-greeting
            data-greetings={JSON.stringify(site.greetings)}
            data-default-greeting={defaultGreeting}
            aria-hidden="true"
          >{defaultGreeting}</span><span class="greeting-dot" aria-hidden="true">.</span>
        </h1>
        <p class="hero-mark"><span class="greeting-dot">{copy.home.praIdentity}</span> {copy.home.identity}</p>
      </div>

      <p class="intro">
        {copy.home.intro}
      </p>

      <HeroScrollCue href="#explore" label={copy.home.scroll} />
    </section>

    <section id="explore" class="explore" aria-labelledby="explore-title">
      <div class="section-heading">
        <div>
          <p class="kicker"><span></span> {copy.home.kicker}</p>
          <h2 id="explore-title"><em>{copy.home.headingEmphasis}</em> {copy.home.headingRest}</h2>
        </div>
        <p class="section-copy">
          {copy.home.sectionIntro}
        </p>
      </div>

      <div class="accordion">
        {sections.map((section, index) => (
          <details open={index === 0} data-smooth-details>
            <summary>
              <span class="title">{section.title}</span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <div class="panel">
              {index === 0 ? (
                <>
                  <div class="carousel-panel-copy">
                    <h3>{copy.home.experiencePreview.title}</h3>
                    <p>{copy.home.experiencePreview.intro}</p>
                  </div>

                  <a class="panel-cta" href={experienceHref}>
                    {copy.home.experiencePreview.cta}
                    <span aria-hidden="true">↗</span>
                  </a>

                  <div
                    class="experience-carousel"
                    data-auto-carousel
                    role="region"
                    aria-label={copy.home.experiencePreview.ariaLabel}
                    tabindex="0"
                  >
                    <div class="experience-track">
                      <div class="experience-set">
                        {experiences.map((experience) => (
                          <a
                            class="experience-card"
                            href={`${experienceHref}#${getExperienceId(experience.company)}`}
                          >
                            <div>
                              <h4>{experience.company}</h4>
                              <p>{experience.role}</p>
                            </div>
                            <p class="experience-card-period">{experience.period}</p>
                            <span class="experience-card-arrow" aria-hidden="true">↗</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                </>
              ) : index === 1 ? (
                <>
                  <div class="carousel-panel-copy">
                    <h3>{copy.home.projectPreview.title}</h3>
                    <p>{copy.home.projectPreview.intro}</p>
                  </div>

                  <a class="panel-cta" href={projectsHref}>
                    {copy.home.projectPreview.cta}
                    <span aria-hidden="true">↗</span>
                  </a>

                  <div
                    class="experience-carousel"
                    data-auto-carousel
                    role="region"
                    aria-label={copy.home.projectPreview.ariaLabel}
                    tabindex="0"
                  >
                    <div class="experience-track">
                      <div class="experience-set">
                        {projects.map((project) => {
                          const projectContent = project.content[locale];

                          return (
                            <a
                              class="experience-card"
                              href={getLocalizedPath(locale, `/projects/${project.slug}`)}
                            >
                              <div>
                                <h4>{projectContent.title}</h4>
                                <p>{project.company}</p>
                              </div>
                              <p class="experience-card-period">{projectContent.type}</p>
                              <span class="experience-card-arrow" aria-hidden="true">↗</span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </>
              ) : (
                <>
                  <div class="carousel-panel-copy">
                    <h3>{copy.home.writingPreview.title}</h3>
                    <p>{copy.home.writingPreview.intro}</p>
                  </div>

                  <a class="panel-cta" href={writingHref}>
                    {copy.home.writingPreview.cta}
                    <span aria-hidden="true">↗</span>
                  </a>

                  {writingEntries.length > 0 ? (
                    <div
                      class="experience-carousel"
                      data-auto-carousel
                      role="region"
                      aria-label={copy.home.writingPreview.ariaLabel}
                      tabindex="0"
                    >
                      <div class="experience-track">
                        <div class="experience-set">
                          {writingEntries.map((entry) => (
                            <a
                              class="experience-card"
                              href={getWritingPath(entry, locale)}
                            >
                              <div>
                                <h4>{entry.data.title}</h4>
                                <p>{copy.writing.filters[entry.data.language]}</p>
                              </div>
                              <p class="experience-card-period">
                                {formatWritingDate(entry.data.publishedAt, locale)}
                              </p>
                              <span class="experience-card-arrow" aria-hidden="true">↗</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="panel-art panel-art--empty">
                      <span aria-hidden="true">{copy.home.writingPreview.emptyMark}</span>
                      <p>{copy.home.writingPreview.empty}</p>
                    </div>
                  )}
                </>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .hero {
    --content-width: 52rem;
    position: relative;
    display: grid;
    min-height: calc(100svh - 2rem);
    padding: 3rem var(--page-pad) 1.5rem;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(28rem, 1fr) auto auto;
  }

  .hero-heading {
    align-self: center;
  }

  h1 {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: clamp(4.5rem, 24vw, 13rem);
    font-weight: 800;
    line-height: 0.77;
    letter-spacing: -0.095em;
    white-space: nowrap;
  }

  .greeting-dot {
    color: var(--accent);
  }

  .hero-mark {
    margin: 1.15rem 0 0 0.15rem;
    font-size: clamp(1rem, 4vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .intro {
    align-self: end;
    max-width: 34rem;
    margin: 0 0 3.5rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .explore {
    padding: 5rem var(--page-pad);
    background: #fff;
  }

  .section-heading {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
    margin: 0 auto 2.5rem;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .kicker span {
    width: 1rem;
    height: 2px;
    background: var(--accent);
  }

  h2 {
    margin: 0;
    font-size: clamp(2.35rem, 12vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  h2 em {
    color: var(--accent);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .section-copy {
    max-width: 23rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .accordion {
    display: grid;
    gap: 0.65rem;
    max-width: 52rem;
    margin: 0 auto;
  }

  details {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease);
  }

  details[open] {
    background: var(--ink);
    color: #fff;
  }

  summary {
    display: grid;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.9rem 1rem;
    cursor: pointer;
    list-style: none;
    grid-template-columns: 1fr 2rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .toggle {
    position: relative;
    width: 1.8rem;
    height: 1.8rem;
    justify-self: end;
    border-radius: 50%;
    background: #fff;
  }

  .toggle::before,
  .toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.65rem;
    height: 1px;
    background: var(--ink);
    content: "";
    transform: translate(-50%, -50%);
  }

  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  details[open] .toggle {
    background: var(--accent);
  }

  details[open] .toggle::before,
  details[open] .toggle::after {
    background: #fff;
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .panel {
    display: grid;
    min-width: 0;
    gap: 1.25rem;
    padding: 0.25rem 1rem 1rem;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  details[open]:not([data-closing]) .panel {
    opacity: 1;
    transform: translateY(0);
  }

  .panel > p,
  .carousel-panel-copy p {
    max-width: 27rem;
    margin: 0;
    color: #bdbdbd;
    font-size: 0.76rem;
  }

  .carousel-panel-copy {
    display: grid;
    gap: 0.65rem;
  }

  .carousel-panel-copy h3 {
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1.75rem, 8vw, 3.25rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .carousel-panel-copy p {
    line-height: 1.55;
  }

  .panel-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: fit-content;
    min-width: 9.5rem;
    padding: 0.55rem 0.6rem 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--accent);
    font-size: 0.67rem;
    font-weight: 800;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .panel-cta:hover,
  .panel-cta:focus-visible {
    background: var(--electric);
    transform: translateX(0.2rem);
  }

  .panel-cta span {
    margin-left: 1rem;
    font-size: 0.85rem;
  }

  .panel-art {
    display: grid;
    overflow: hidden;
    min-height: 8rem;
    margin-top: 0.5rem;
    place-items: center;
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, transparent 49.5%, rgba(255, 255, 255, 0.18) 50%, transparent 50.5%),
      var(--electric);
    color: var(--ink);
  }

  .panel-art span {
    font-family: "Arial Black", Arial, sans-serif;
    font-size: 4rem;
    font-weight: 900;
    letter-spacing: -0.1em;
  }

  .panel-art--empty {
    align-content: center;
    gap: 0.5rem;
  }

  .panel-art--empty p {
    margin: 0;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .experience-carousel {
    width: 100%;
    padding: 0.25rem 0;
    overflow-x: auto;
    cursor: grab;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
  }

  .experience-carousel::-webkit-scrollbar {
    display: none;
  }

  .experience-carousel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .experience-carousel.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .experience-track,
  .experience-set {
    display: flex;
    width: max-content;
  }

  .experience-set {
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  .experience-card {
    position: relative;
    display: grid;
    width: min(68vw, 18rem);
    min-height: 17rem;
    padding: 1.2rem;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    background: #191919;
    color: #fff;
    grid-template-rows: 1fr auto;
    scroll-snap-align: start;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .experience-card::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3.5rem;
    width: 9rem;
    height: 9rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    content: "";
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .experience-card:hover,
  .experience-card:focus-visible {
    background: var(--night);
    transform: translateY(-0.25rem);
  }

  .experience-card:hover::after,
  .experience-card:focus-visible::after {
    transform: scale(1.15);
  }

  .experience-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .experience-card > div {
    align-self: center;
  }

  .experience-card h4 {
    max-width: 15rem;
    margin: 0;
    font-size: clamp(1.5rem, 7vw, 2.25rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .experience-card > div p,
  .experience-card-period {
    margin: 0;
    color: #bdbdbd;
    font-size: 0.7rem;
  }

  .experience-card > div p {
    margin-top: 0.7rem;
  }

  .experience-card-period {
    align-self: end;
    max-width: 11rem;
    line-height: 1.4;
  }

  .experience-card-arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: calc(100vh - 4.8rem);
      padding-top: 4rem;
      padding-right: max(var(--page-pad), calc((100vw - var(--content-width)) / 2));
      padding-left: max(var(--page-pad), calc((100vw - var(--content-width)) / 2));
      column-gap: clamp(2rem, 5vw, 4rem);
      grid-template-columns: minmax(0, 1.65fr) minmax(13rem, 0.8fr);
      grid-template-rows: 1fr auto;
    }

    .hero-heading {
      align-self: center;
      margin: 0;
      padding-top: 0;
      transform: translateY(5vh);
    }

    h1 {
      font-size: clamp(5rem, 9vw, 8rem);
    }

    .intro {
      align-self: center;
      margin: 0;
      transform: translateY(5vh);
    }

    .explore {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }

    .experience-card {
      width: 18rem;
      min-height: 17rem;
      padding: 1.4rem;
    }

    .experience-card h4 {
      font-size: 2.2rem;
    }

    summary {
      min-height: 5rem;
      padding-right: 1.4rem;
      padding-left: 1.4rem;
      grid-template-columns: 1fr 2rem;
    }

    .title {
      font-size: 1.25rem;
    }

    .panel {
      grid-template-columns: 1fr;
      padding: 0.5rem 1.4rem 1.4rem;
    }

    .panel-art {
      min-height: 14rem;
      margin-top: 0.5rem;
    }
  }

</style>

<script>
  const greeting = document.querySelector<HTMLElement>("[data-greeting]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (greeting && !reduceMotion.matches && greeting.dataset.typingReady !== "true") {
    greeting.dataset.typingReady = "true";

    const greetings = JSON.parse(greeting.dataset.greetings ?? "[]") as string[];
    const defaultGreeting = greeting.dataset.defaultGreeting ?? "";
    let greetingIndex = 0;
    let characterIndex = Array.from(greetings[0] ?? defaultGreeting).length;
    let isDeleting = true;

    const tick = () => {
      const word = Array.from(greetings[greetingIndex] ?? defaultGreeting);

      if (isDeleting) {
        characterIndex = Math.max(0, characterIndex - 1);
      } else {
        characterIndex = Math.min(word.length, characterIndex + 1);
      }

      greeting.textContent = word.slice(0, characterIndex).join("");

      let delay = isDeleting ? 55 : 105;

      if (isDeleting && characterIndex === 0) {
        isDeleting = false;
        greetingIndex = (greetingIndex + 1) % greetings.length;
        delay = 360;
      } else if (!isDeleting && characterIndex === word.length) {
        isDeleting = true;
        delay = 1600;
      }

      window.setTimeout(tick, delay);
    };

    window.setTimeout(tick, 1800);
  }

  document.querySelectorAll<HTMLElement>("[data-auto-carousel]").forEach((carousel) => {
    if (carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";
    const containingDetails = carousel.closest<HTMLDetailsElement>("details");

    let isHovering = false;
    let isInteracting = false;
    let isFocused = false;
    let isResetting = false;
    let isDragging = false;
    let didDrag = false;
    let dragStartX = 0;
    let dragStartScroll = 0;
    carousel.scrollLeft = 0;
    let autoScrollPosition = 0;
    let resumeTimer: number | undefined;
    let previousTime = performance.now();

    const pauseTemporarily = () => {
      isInteracting = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        isInteracting = false;
      }, 1200);
    };

    const animate = (currentTime: number) => {
      const delta = Math.min(currentTime - previousTime, 64);
      previousTime = currentTime;
      const isVisible =
        (!containingDetails || containingDetails.open) &&
        carousel.clientWidth > 0 &&
        carousel.getClientRects().length > 0;

      if (!isVisible) {
        autoScrollPosition = 0;
        carousel.scrollLeft = 0;
      } else if (
        !reduceMotion.matches &&
        !isHovering &&
        !isInteracting &&
        !isFocused &&
        !isResetting &&
        !document.hidden
      ) {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        autoScrollPosition += (delta / 1000) * 24;

        if (maxScroll <= 0) {
          autoScrollPosition = 0;
        } else if (autoScrollPosition >= maxScroll) {
          isResetting = true;
          autoScrollPosition = 0;
          carousel.scrollTo({ left: 0, behavior: "smooth" });

          window.setTimeout(() => {
            autoScrollPosition = carousel.scrollLeft;
            isResetting = false;
          }, 700);
        } else {
          carousel.scrollLeft = autoScrollPosition;
        }
      } else {
        autoScrollPosition = carousel.scrollLeft;
      }

      window.requestAnimationFrame(animate);
    };

    carousel.addEventListener("mouseenter", () => {
      isHovering = true;
    });
    carousel.addEventListener("mouseleave", () => {
      isHovering = false;
    });
    carousel.addEventListener("focusin", () => {
      isFocused = true;
    });
    carousel.addEventListener("focusout", () => {
      isFocused = carousel.contains(document.activeElement);
    });
    carousel.addEventListener("touchstart", pauseTemporarily, { passive: true });
    carousel.addEventListener("touchend", pauseTemporarily, { passive: true });
    carousel.addEventListener("wheel", pauseTemporarily, { passive: true });

    carousel.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      isDragging = true;
      didDrag = false;
      dragStartX = event.clientX;
      dragStartScroll = carousel.scrollLeft;
      carousel.classList.add("is-dragging");
      carousel.setPointerCapture(event.pointerId);
      pauseTemporarily();
    });

    carousel.addEventListener("pointermove", (event) => {
      if (!isDragging) return;
      const distance = event.clientX - dragStartX;
      if (Math.abs(distance) > 4) didDrag = true;
      carousel.scrollLeft = dragStartScroll - distance;
    });

    const endDrag = (event: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      carousel.classList.remove("is-dragging");
      if (carousel.hasPointerCapture(event.pointerId)) {
        carousel.releasePointerCapture(event.pointerId);
      }
      pauseTemporarily();
    };

    carousel.addEventListener("pointerup", endDrag);
    carousel.addEventListener("pointercancel", endDrag);
    carousel.addEventListener("click", (event) => {
      if (!didDrag) return;
      event.preventDefault();
      event.stopPropagation();
      didDrag = false;
    }, true);

    window.requestAnimationFrame(animate);
  });
</script>

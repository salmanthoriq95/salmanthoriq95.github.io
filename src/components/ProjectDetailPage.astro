---
import {
  projectPageContent,
  projects,
  type Project,
} from "../data/projects";
import { site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const copy = projectPageContent;
const content = project.content;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
const nextContent = nextProject.content;
const projectsPath = "/projects";
const nextProjectPath = `/projects/${nextProject.slug}`;
const stackLabel = project.stackKind === "tools"
  ? copy.labels.tools
  : copy.labels.technologies;
const contextParagraphs = content.summary.slice(1);
const media = project.media ?? [];
---

<SiteLayout
  title={`${content.title} — ${site.author.shortName}`}
  description={content.summary[0]}
>
  <main>
    <section class="project-hero" aria-labelledby="project-title">
      <a class="back-link" href={projectsPath}>← {copy.labels.back}</a>

      <div class="hero-heading">
        <h1 id="project-title">{content.title}<span aria-hidden="true">.</span></h1>
        <p>{content.summary[0]}</p>
        <ul class="hero-stack" aria-label={stackLabel}>
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <dl class="metadata">
        <div>
          <dt>{copy.labels.company}</dt>
          <dd>{project.company}</dd>
        </div>
        <div>
          <dt>{copy.labels.role}</dt>
          <dd>{content.role}</dd>
        </div>
        <div>
          <dt>{copy.labels.type}</dt>
          <dd>{content.type}</dd>
        </div>
        <div>
          <dt>{copy.labels.contribution}</dt>
          <dd>{content.contribution}</dd>
        </div>
      </dl>
    </section>

    <article class:list={["project-body", { "project-body--without-media": media.length === 0 }]}>
      {media.length > 0 && (
        <section
          class="project-gallery"
          aria-label={copy.labels.gallery}
          data-project-gallery
        >
          <div
            class="gallery-scroller"
            data-gallery-scroller
            role="region"
            aria-label={`${copy.labels.gallery}: ${content.title}`}
            tabindex="0"
          >
            <div class="gallery-track" data-gallery-track>
              {media.map((visual, index) => (
                <figure
                  class="project-visual"
                  data-gallery-slide
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <img
                    src={visual.src}
                    alt={visual.alt}
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    draggable="false"
                  />
                  {visual.caption && <figcaption>{visual.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>

          {media.length > 1 && (
            <div class="gallery-pagination" role="group" aria-label={copy.labels.gallery}>
              {media.map((visual, index) => (
                <button
                  class:list={["gallery-dot", { "is-active": index === 0 }]}
                  type="button"
                  aria-label={visual.caption ?? visual.alt}
                  aria-current={index === 0 ? "true" : undefined}
                  data-gallery-dot
                  data-gallery-index={index}
                >
                  <span aria-hidden="true"></span>
                </button>
              ))}
            </div>
          )}
        </section>
      )}

      <section class="project-narrative" aria-labelledby="contributions-title">
        {contextParagraphs.length > 0 && (
          <div class="context-copy">
            {contextParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}

        <div class="contribution-story">
          <p class="eyebrow eyebrow--inverse"><span></span>{copy.labels.contributions}</p>
          <h2 id="contributions-title">
            {content.contribution}<span aria-hidden="true">.</span>
          </h2>
          <div class="story-copy">
            {content.contributions.map((contribution) => <p>{contribution}</p>)}
          </div>
        </div>
      </section>

      {content.additional && (
        <aside class="additional">
          <p class="additional-title">{content.additional.title}</p>
          <div>
            {content.additional.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </aside>
      )}

      <p class="privacy-note">{copy.labels.privacy}</p>
    </article>

    <nav class="next-project" aria-label={copy.labels.next}>
      <div class="next-project-inner">
        <a href={nextProjectPath}>
          <span>{nextContent.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </nav>
  </main>

</SiteLayout>

<style>
  .project-hero,
  .project-gallery,
  .project-narrative,
  .additional,
  .privacy-note,
  .next-project-inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .project-hero {
    padding: 2rem var(--page-pad) 3rem;
  }

  .back-link,
  .next-project a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .back-link:hover,
  .back-link:focus-visible,
  .next-project a:hover,
  .next-project a:focus-visible {
    color: var(--accent);
  }

  .hero-heading {
    margin-top: 4.5rem;
  }

  h1 {
    max-width: 48rem;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(3rem, 14vw, 6.5rem);
    line-height: 0.84;
    letter-spacing: -0.08em;
  }

  h1 > span,
  h2 > span {
    color: var(--accent);
  }

  .hero-heading > p {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-stack li {
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.63rem;
  }

  .metadata {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .metadata dt {
    margin-bottom: 0.3rem;
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .metadata dd {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .project-body {
    padding: 5rem var(--page-pad);
    background: #fff;
  }

  .gallery-scroller {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
  }

  .gallery-scroller:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.3rem;
  }

  .gallery-scroller.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .gallery-track {
    display: flex;
    width: 100%;
    gap: 0;
    will-change: transform;
    transition: transform 480ms var(--motion-ease);
  }

  .gallery-track.is-dragging {
    transition: none;
  }

  .project-visual {
    width: 100%;
    min-height: 18rem;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .project-visual {
    position: relative;
    margin: 0;
    background: var(--paper-deep);
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    object-fit: cover;
  }

  .project-visual figcaption {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    width: fit-content;
    max-width: calc(100% - 1.6rem);
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.78);
    color: #fff;
    font-size: 0.6rem;
  }

  .gallery-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }

  .gallery-dot {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .gallery-dot span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .gallery-dot:hover span,
  .gallery-dot:focus-visible span {
    background: var(--muted);
    transform: scale(1.2);
  }

  .gallery-dot.is-active span {
    background: var(--accent);
    transform: scale(1.2);
  }

  .gallery-dot:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 0.1rem;
    border-radius: 50%;
  }

  .project-narrative {
    margin-top: 1.25rem;
  }

  .project-body--without-media .project-narrative {
    margin-top: 0;
  }

  .context-copy,
  .story-copy,
  .additional > div {
    display: grid;
    gap: 1rem;
  }

  .context-copy p,
  .story-copy p,
  .additional > div p {
    margin: 0;
    color: #30302e;
    font-size: clamp(0.96rem, 2vw, 1.08rem);
    line-height: 1.78;
  }

  .contribution-story {
    margin-top: 5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
  }

  h2 {
    max-width: 43rem;
    margin: 0.85rem 0 0;
    font-size: clamp(2.6rem, 11vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .story-copy {
    width: 100%;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .story-copy p {
    color: #d0d0d0;
  }

  .additional {
    display: grid;
    gap: 1.5rem;
    margin-top: 5rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--electric);
  }

  .additional-title {
    margin: 0;
    color: var(--ink);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .additional > div p {
    color: var(--ink);
  }

  .privacy-note {
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .next-project {
    padding: 0 var(--page-pad) 5rem;
    background: #fff;
  }

  .next-project-inner {
    display: flex;
    justify-content: flex-end;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .next-project a {
    max-width: 100%;
  }

  .next-project a span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .project-hero {
      padding: 3rem 0 4rem;
    }

    .hero-heading {
      margin-top: 6rem;
    }

    h1 {
      font-size: clamp(4.75rem, 7.5vw, 6.5rem);
    }

    .metadata {
      grid-template-columns: 0.75fr 0.85fr 1fr 1.4fr;
    }

    .project-body {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }

    .project-visual {
      min-height: 28rem;
    }

    .project-visual img {
      min-height: 28rem;
    }

    .project-narrative {
      margin-top: 7rem;
    }

    .contribution-story {
      margin-top: 7rem;
      padding: 2rem;
    }

    .additional {
      grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
      margin-top: 7rem;
      padding: 2rem;
      gap: 2rem;
    }

    .next-project {
      padding-bottom: 7rem;
    }
  }
</style>

<script>
  const reduceGalleryMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-project-gallery]").forEach((gallery) => {
    if (gallery.dataset.galleryReady === "true") return;
    gallery.dataset.galleryReady = "true";

    const scroller = gallery.querySelector<HTMLElement>("[data-gallery-scroller]");
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    const slides = Array.from(
      gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"),
    );
    const dots = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"),
    );

    if (!scroller || !track || slides.length < 2 || dots.length !== slides.length) return;

    let activeIndex = 0;
    let pointerId: number | undefined;
    let pointerStart = 0;
    let pointerOffset = 0;

    const showSlide = (nextIndex: number, animate = true) => {
      activeIndex = Math.max(0, Math.min(nextIndex, slides.length - 1));
      track.classList.toggle("is-dragging", !animate);
      track.style.transform = `translate3d(${-activeIndex * 100}%, 0, 0)`;

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle("is-active", isActive);

        if (isActive) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });
      slides.forEach((slide, index) => {
        slide.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
      });

      if (!animate) {
        window.requestAnimationFrame(() => track.classList.remove("is-dragging"));
      }
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showSlide(index, !reduceGalleryMotion.matches);
      });
    });

    scroller.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;

      pointerId = event.pointerId;
      pointerStart = event.clientX;
      pointerOffset = 0;
      scroller.classList.add("is-dragging");
      track.classList.add("is-dragging");
      scroller.setPointerCapture(event.pointerId);
    });

    scroller.addEventListener("pointermove", (event) => {
      if (pointerId !== event.pointerId) return;

      pointerOffset = event.clientX - pointerStart;
      const dragPercent = (pointerOffset / scroller.clientWidth) * 100;
      track.style.transform = `translate3d(${(-activeIndex * 100) + dragPercent}%, 0, 0)`;
    });

    const finishDrag = (event: PointerEvent, navigate: boolean) => {
      if (pointerId !== event.pointerId) return;

      const threshold = Math.min(80, scroller.clientWidth * 0.14);
      let nextIndex = activeIndex;

      if (navigate && Math.abs(pointerOffset) >= threshold) {
        nextIndex += pointerOffset < 0 ? 1 : -1;
      }

      if (scroller.hasPointerCapture(event.pointerId)) {
        scroller.releasePointerCapture(event.pointerId);
      }

      pointerId = undefined;
      pointerOffset = 0;
      scroller.classList.remove("is-dragging");
      track.classList.remove("is-dragging");
      showSlide(nextIndex, !reduceGalleryMotion.matches);
    };

    scroller.addEventListener("pointerup", (event) => finishDrag(event, true));
    scroller.addEventListener("pointercancel", (event) => finishDrag(event, false));

    scroller.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      showSlide(activeIndex + direction, !reduceGalleryMotion.matches);
    });

    showSlide(0, false);
  });
</script>

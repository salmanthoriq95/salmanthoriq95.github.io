---
import {
  projectPageContent,
  projects,
  type Project,
} from "../data/projects";
import { defaultLocale, getLocalizedPath, type Locale } from "../i18n";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  locale?: Locale;
  project: Project;
}

const { locale = defaultLocale, project } = Astro.props;
const copy = projectPageContent[locale];
const content = project.content[locale];
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
const nextContent = nextProject.content[locale];
const projectsPath = getLocalizedPath(locale, "/projects");
const nextProjectPath = getLocalizedPath(locale, `/projects/${nextProject.slug}`);
const stackLabel = project.stackKind === "tools"
  ? copy.labels.tools
  : copy.labels.technologies;
const contextParagraphs = content.summary.slice(1);
const media = project.media ?? [];
---

<BaseLayout
  locale={locale}
  title={`${content.title} — ${site.author.shortName}`}
  description={content.summary[0]}
>
  <Header locale={locale} />

  <main>
    <section class="project-hero" aria-labelledby="project-title">
      <a class="back-link" href={projectsPath}>← {copy.labels.back}</a>

      <div class="hero-heading">
        <h1 id="project-title">{content.title}<span aria-hidden="true">.</span></h1>
        <p>{content.summary[0]}</p>
        <ul class="hero-stack" aria-label={stackLabel}>
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <dl class="metadata">
        <div>
          <dt>{copy.labels.company}</dt>
          <dd>{project.company}</dd>
        </div>
        <div>
          <dt>{copy.labels.role}</dt>
          <dd>{content.role}</dd>
        </div>
        <div>
          <dt>{copy.labels.type}</dt>
          <dd>{content.type}</dd>
        </div>
        <div>
          <dt>{copy.labels.contribution}</dt>
          <dd>{content.contribution}</dd>
        </div>
      </dl>
    </section>

    <article class="project-body">
      <section class="project-gallery" aria-label={copy.labels.gallery}>
        <div
          class="gallery-scroller"
          data-project-gallery
          role="region"
          aria-label={`${copy.labels.gallery}: ${content.title}`}
          tabindex="0"
        >
          <div class="gallery-track">
            {media.length > 0 ? (
              media.map((visual) => (
                <figure class="project-visual">
                  <img
                    src={visual.src}
                    alt={visual.alt[locale]}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                  {visual.caption && <figcaption>{visual.caption[locale]}</figcaption>}
                </figure>
              ))
            ) : (
              <div class="project-mark" aria-hidden="true">
                <span></span>
              </div>
            )}
          </div>
        </div>
      </section>

      <section class="project-narrative" aria-labelledby="contributions-title">
        {contextParagraphs.length > 0 && (
          <div class="context-copy">
            {contextParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}

        <div class="contribution-story">
          <p class="eyebrow"><span></span>{copy.labels.contributions}</p>
          <h2 id="contributions-title">
            {content.contribution}<span aria-hidden="true">.</span>
          </h2>
          <div class="story-copy">
            {content.contributions.map((contribution) => <p>{contribution}</p>)}
          </div>
        </div>
      </section>

      {content.additional && (
        <aside class="additional">
          <p class="additional-title">{content.additional.title}</p>
          <div>
            {content.additional.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </aside>
      )}

      <p class="privacy-note">{copy.labels.privacy}</p>
    </article>

    <nav class="next-project" aria-label={copy.labels.next}>
      <div class="next-project-inner">
        <a href={nextProjectPath}>
          <span>{nextContent.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </nav>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .project-hero,
  .project-gallery,
  .project-narrative,
  .additional,
  .privacy-note,
  .next-project-inner {
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .project-hero {
    padding: 2rem var(--page-pad) 3rem;
  }

  .back-link,
  .next-project a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .back-link:hover,
  .back-link:focus-visible,
  .next-project a:hover,
  .next-project a:focus-visible {
    color: var(--accent);
  }

  .hero-heading {
    margin-top: 4.5rem;
  }

  h1 {
    max-width: 48rem;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(3rem, 14vw, 6.5rem);
    line-height: 0.84;
    letter-spacing: -0.08em;
  }

  h1 > span,
  h2 > span {
    color: var(--accent);
  }

  .hero-heading > p {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-stack li {
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.63rem;
  }

  .metadata {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .metadata dt {
    margin-bottom: 0.3rem;
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .metadata dd {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .project-body {
    padding: 5rem var(--page-pad);
    background: #fff;
  }

  .gallery-scroller {
    width: 100%;
    overflow-x: auto;
    cursor: grab;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
  }

  .gallery-scroller::-webkit-scrollbar {
    display: none;
  }

  .gallery-scroller:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.3rem;
  }

  .gallery-scroller.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  .project-visual,
  .project-mark {
    width: min(calc(100vw - (2 * var(--page-pad))), 52rem);
    min-height: 18rem;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: var(--radius);
    scroll-snap-align: start;
  }

  .project-visual {
    position: relative;
    margin: 0;
    background: var(--paper-deep);
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    object-fit: cover;
  }

  .project-visual figcaption {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    width: fit-content;
    max-width: calc(100% - 1.6rem);
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.78);
    color: #fff;
    font-size: 0.6rem;
  }

  .project-mark {
    position: relative;
    background:
      linear-gradient(135deg, transparent 49.6%, rgba(255, 255, 255, 0.22) 50%, transparent 50.4%),
      var(--electric);
  }

  .project-mark span {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    width: clamp(2.5rem, 9vw, 4.5rem);
    aspect-ratio: 1;
    background: var(--accent);
  }

  .project-narrative {
    margin-top: 5rem;
  }

  .context-copy,
  .story-copy,
  .additional > div {
    display: grid;
    gap: 1rem;
  }

  .context-copy p,
  .story-copy p,
  .additional > div p {
    margin: 0;
    color: #30302e;
    font-size: clamp(0.96rem, 2vw, 1.08rem);
    line-height: 1.78;
  }

  .contribution-story {
    margin-top: 5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: #bdbdbd;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    width: 1rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--accent);
  }

  h2 {
    max-width: 43rem;
    margin: 0.85rem 0 0;
    font-size: clamp(2.6rem, 11vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .story-copy {
    width: 100%;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .story-copy p {
    color: #d0d0d0;
  }

  .additional {
    display: grid;
    gap: 1.5rem;
    margin-top: 5rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--electric);
  }

  .additional-title {
    margin: 0;
    color: var(--ink);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .additional > div p {
    color: var(--ink);
  }

  .privacy-note {
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .next-project {
    padding: 0 var(--page-pad) 5rem;
    background: #fff;
  }

  .next-project-inner {
    display: flex;
    justify-content: flex-end;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .next-project a {
    max-width: 100%;
  }

  .next-project a span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .project-hero {
      padding: 3rem 0 4rem;
    }

    .hero-heading {
      margin-top: 6rem;
    }

    h1 {
      font-size: clamp(4.75rem, 7.5vw, 6.5rem);
    }

    .metadata {
      grid-template-columns: 0.75fr 0.85fr 1fr 1.4fr;
    }

    .project-body {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }

    .project-visual,
    .project-mark {
      min-height: 28rem;
    }

    .project-visual img {
      min-height: 28rem;
    }

    .project-narrative {
      margin-top: 7rem;
    }

    .contribution-story {
      margin-top: 7rem;
      padding: 2rem;
    }

    .additional {
      grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
      margin-top: 7rem;
      padding: 2rem;
      gap: 2rem;
    }

    .next-project {
      padding-bottom: 7rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-gallery]").forEach((gallery) => {
    let isDragging = false;
    let startX = 0;
    let startScroll = 0;

    gallery.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.button !== 0) return;

      isDragging = true;
      startX = event.clientX;
      startScroll = gallery.scrollLeft;
      gallery.classList.add("is-dragging");
      gallery.setPointerCapture(event.pointerId);
      event.preventDefault();
    });

    gallery.addEventListener("pointermove", (event) => {
      if (!isDragging) return;
      gallery.scrollLeft = startScroll - (event.clientX - startX);
    });

    const stopDragging = (event: PointerEvent) => {
      if (!isDragging) return;

      isDragging = false;
      gallery.classList.remove("is-dragging");
      if (gallery.hasPointerCapture(event.pointerId)) {
        gallery.releasePointerCapture(event.pointerId);
      }
    };

    gallery.addEventListener("pointerup", stopDragging);
    gallery.addEventListener("pointercancel", stopDragging);
  });
</script>

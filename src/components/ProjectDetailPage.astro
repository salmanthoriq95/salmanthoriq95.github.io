---
import {
  projectPageContent,
  projects,
  type Project,
} from "../data/projects";
import { defaultLocale, getLocalizedPath, type Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  locale?: Locale;
  project: Project;
}

const { locale = defaultLocale, project } = Astro.props;
const copy = projectPageContent[locale];
const content = project.content[locale];
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
const nextContent = nextProject.content[locale];
const projectsPath = getLocalizedPath(locale, "/projects");
const nextProjectPath = getLocalizedPath(locale, `/projects/${nextProject.slug}`);
const stackLabel = project.stackKind === "tools"
  ? copy.labels.tools
  : copy.labels.technologies;
---

<BaseLayout
  locale={locale}
  title={`${content.title} — Salman Thoriq`}
  description={content.summary[0]}
>
  <Header locale={locale} />

  <main>
    <section class="project-hero" aria-labelledby="project-title">
      <a class="back-link" href={projectsPath}>← {copy.labels.back}</a>

      <div class="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow"><span></span>{project.company}</p>
          <h1 id="project-title">{content.title}<span aria-hidden="true">.</span></h1>
          <p>{content.summary[0]}</p>
        </div>

        <div class="project-mark" aria-hidden="true">
          <span>{String(projectIndex + 1).padStart(2, "0")}</span>
        </div>
      </div>

      <dl class="metadata">
        <div>
          <dt>{copy.labels.company}</dt>
          <dd>{project.company}</dd>
        </div>
        <div>
          <dt>{copy.labels.role}</dt>
          <dd>{content.role}</dd>
        </div>
        <div>
          <dt>{copy.labels.type}</dt>
          <dd>{content.type}</dd>
        </div>
        <div>
          <dt>{copy.labels.contribution}</dt>
          <dd>{content.contribution}</dd>
        </div>
      </dl>
    </section>

    <article class="project-body">
      <section class="context content-section" aria-labelledby="context-title">
        <p class="section-number">01.</p>
        <div>
          <p class="eyebrow"><span></span>{copy.labels.context}</p>
          <h2 id="context-title">{content.title}</h2>
        </div>
        <div class="body-copy">
          {content.summary.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="contributions" aria-labelledby="contributions-title">
        <header>
          <p class="section-number">02.</p>
          <div>
            <p class="eyebrow"><span></span>{copy.labels.contributions}</p>
            <h2 id="contributions-title">{content.contribution}</h2>
          </div>
        </header>

        <ol>
          {content.contributions.map((contribution) => <li>{contribution}</li>)}
        </ol>
      </section>

      {content.additional && (
        <aside class="additional">
          <p class="eyebrow"><span></span>{content.additional.title}</p>
          <div>
            {content.additional.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </aside>
      )}

      <section class="stack" aria-labelledby="stack-title">
        <p class="section-number">03.</p>
        <div>
          <p class="eyebrow"><span></span>{stackLabel}</p>
          <h2 id="stack-title">{stackLabel}</h2>
        </div>
        <ul>
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="learning" aria-labelledby="learning-title">
        <p class="section-number">04.</p>
        <div>
          <p class="eyebrow"><span></span>{copy.labels.learning}</p>
          <h2 id="learning-title">{content.learning[0]}</h2>
        </div>
        <div class="learning-copy">
          {content.learning.slice(1).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <p class="privacy-note">{copy.labels.privacy}</p>
    </article>

    <nav class="next-project" aria-label={copy.labels.next}>
      <a href={nextProjectPath}>
        <span>{copy.labels.next}</span>
        <strong>{nextContent.title}</strong>
        <span class="next-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .project-hero,
  .content-section,
  .contributions,
  .additional,
  .stack,
  .learning,
  .privacy-note,
  .next-project a {
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .project-hero {
    padding: 2rem var(--page-pad) 3rem;
  }

  .back-link {
    display: inline-block;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--accent);
  }

  .hero-heading {
    display: grid;
    gap: 2.5rem;
    margin-top: 4.5rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    width: 1rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--accent);
  }

  h1 {
    max-width: 46rem;
    margin: 1rem 0 0;
    overflow-wrap: anywhere;
    font-size: clamp(3rem, 14vw, 6.5rem);
    line-height: 0.84;
    letter-spacing: -0.08em;
  }

  h1 > span {
    color: var(--accent);
  }

  .hero-copy > p:last-child {
    max-width: 29rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .project-mark {
    display: grid;
    min-height: 12rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, transparent 49.6%, rgba(255, 255, 255, 0.2) 50%, transparent 50.4%),
      var(--electric);
  }

  .project-mark span {
    font-size: clamp(4rem, 20vw, 8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .metadata {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .metadata dt {
    margin-bottom: 0.3rem;
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .metadata dd {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .project-body {
    padding: 5rem var(--page-pad);
    background: #fff;
  }

  .content-section,
  .stack,
  .learning {
    display: grid;
    gap: 1.5rem;
  }

  .section-number {
    margin: 0;
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 800;
  }

  h2 {
    margin: 0.75rem 0 0;
    font-size: clamp(2.3rem, 11vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .body-copy,
  .learning-copy,
  .additional > div {
    display: grid;
    gap: 0.8rem;
  }

  .body-copy p,
  .learning-copy p,
  .additional > div p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .contributions {
    margin-top: 5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
  }

  .contributions header {
    display: grid;
    gap: 1rem;
  }

  .contributions .eyebrow {
    color: #bdbdbd;
  }

  .contributions h2 {
    max-width: 42rem;
    font-size: clamp(2rem, 9vw, 4.25rem);
  }

  .contributions ol {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: contribution;
  }

  .contributions li {
    position: relative;
    padding: 1rem 0 1rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: #d0d0d0;
    counter-increment: contribution;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .contributions li::before {
    position: absolute;
    top: 1.05rem;
    left: 0;
    color: var(--accent);
    content: counter(contribution, decimal-leading-zero);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .additional {
    display: grid;
    gap: 1.5rem;
    margin-top: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--electric);
  }

  .additional .eyebrow,
  .additional > div p {
    color: var(--ink);
  }

  .stack {
    margin-top: 5rem;
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.68rem;
  }

  .learning {
    margin-top: 5rem;
    padding: 2rem 1.25rem;
    border-radius: var(--radius);
    background: var(--accent);
  }

  .learning .eyebrow,
  .learning-copy p {
    color: var(--ink);
  }

  .learning .eyebrow > span {
    background: var(--ink);
  }

  .learning h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
  }

  .privacy-note {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .next-project {
    padding: 0 var(--page-pad) 5rem;
    background: #fff;
  }

  .next-project a {
    position: relative;
    display: grid;
    min-height: 18rem;
    padding: 1.5rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--night);
    color: #fff;
    grid-template-rows: auto 1fr;
    transition:
      border-radius var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .next-project a:hover,
  .next-project a:focus-visible {
    border-radius: 2.25rem;
    transform: translateY(-0.3rem);
  }

  .next-project a > span:first-child {
    color: #c9bdca;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .next-project strong {
    max-width: 40rem;
    align-self: center;
    font-size: clamp(2.25rem, 10vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  .next-arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 50%;
    background: var(--electric);
    color: var(--night);
  }

  @media (min-width: 40rem) {
    .metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .project-hero {
      padding: 3rem 0 4rem;
    }

    .hero-heading {
      align-items: end;
      margin-top: 6rem;
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
      gap: 2.5rem;
    }

    h1 {
      font-size: clamp(4.75rem, 7.5vw, 6.5rem);
    }

    .project-mark {
      min-height: 20rem;
    }

    .metadata {
      grid-template-columns: 0.75fr 0.85fr 1fr 1.4fr;
    }

    .project-body {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }

    .content-section,
    .stack,
    .learning {
      grid-template-columns: 3.5rem minmax(0, 1.25fr) minmax(14rem, 0.75fr);
      gap: 2rem;
    }

    .contributions {
      margin-top: 7rem;
      padding: 2rem;
    }

    .contributions header {
      grid-template-columns: 3.5rem 1fr;
      gap: 2rem;
    }

    .contributions ol {
      margin-left: 5.5rem;
    }

    .additional {
      grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
      margin-top: 1rem;
      padding: 2rem;
      gap: 2rem;
    }

    .stack,
    .learning {
      margin-top: 7rem;
    }

    .learning {
      padding: 3rem 2rem;
    }

    .next-project {
      padding-bottom: 7rem;
    }

    .next-project a {
      min-height: 24rem;
      padding: 2rem;
    }
  }
</style>

---
import { ui } from "../data/ui";

const label = ui.actions.scrollToTop;
---

<button
  class="scroll-to-top"
  type="button"
  aria-label={label}
  title={label}
  aria-hidden="true"
  tabindex="-1"
  data-scroll-to-top
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 19V5m-6 6 6-6 6 6"></path>
  </svg>
</button>

<style>
  .scroll-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    width: 3rem;
    height: 3rem;
    padding: 0;
    place-items: center;
    visibility: hidden;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0.7rem 1.8rem rgba(10, 10, 10, 0.2);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      visibility var(--motion-duration) var(--motion-ease),
      opacity var(--motion-duration) var(--motion-ease),
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .scroll-to-top.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-to-top:hover,
  .scroll-to-top:focus-visible {
    background: var(--accent);
    transform: translateY(-0.2rem);
  }

  .scroll-to-top:focus-visible {
    outline: 2px solid var(--electric);
    outline-offset: 0.2rem;
  }

  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  @media (min-width: 48rem) {
    .scroll-to-top {
      right: 2rem;
      bottom: 2rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-scroll-to-top]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let updateQueued = false;

  const updateVisibility = () => {
    const isVisible = window.scrollY > Math.max(window.innerHeight * 0.85, 320);

    buttons.forEach((button) => {
      button.classList.toggle("is-visible", isVisible);
      button.ariaHidden = String(!isVisible);
      button.tabIndex = isVisible ? 0 : -1;
    });
    updateQueued = false;
  };

  const requestVisibilityUpdate = () => {
    if (updateQueued) return;
    updateQueued = true;
    window.requestAnimationFrame(updateVisibility);
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    });
  });

  window.addEventListener("scroll", requestVisibilityUpdate, { passive: true });
  window.addEventListener("resize", requestVisibilityUpdate);
  updateVisibility();
</script>

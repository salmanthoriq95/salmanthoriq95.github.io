---
import { defaultLocale, type Locale } from "../i18n";
import { ui } from "../i18n/ui";
import {
  formatWritingDate,
  getDirectChildTopics,
  getPublishedWriting,
  getTopicLabel,
  getTopicPath,
  getWritingPath,
} from "../lib/writing";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import HeroScrollCue from "./HeroScrollCue.astro";
import WritingCard from "./WritingCard.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = ui[locale].writing;
const entries = await getPublishedWriting();
const featuredEntries = entries.filter((entry) => entry.data.featured);
const topics = getDirectChildTopics(entries);
const firstSectionPath = featuredEntries.length > 0 ? "#featured-writing" : "#writing-archive";
---

<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <Header locale={locale} />

  <main>
    <section class="writing-hero" aria-labelledby="writing-title">
      <div class="hero-grid">
        <h1 id="writing-title">
          <em>{copy.hero.emphasis}</em>
          <span>{copy.hero.title}</span>
        </h1>
        <p>{copy.hero.intro}</p>
      </div>

      <HeroScrollCue href={firstSectionPath} label={copy.hero.count} />
    </section>

    {
      featuredEntries.length > 0 && (
        <section id="featured-writing" class="featured" aria-labelledby="featured-title">
          <header class="section-heading">
            <div>
              <p class="eyebrow"><span></span>{copy.featured.label}</p>
              <h2 id="featured-title">{copy.featured.title}</h2>
            </div>
            <p>{copy.featured.intro}</p>
          </header>

          <div class="featured-grid">
            {featuredEntries.map((entry) => (
              <a class="featured-card" href={getWritingPath(entry, locale)}>
                <div class="featured-meta">
                  <time datetime={entry.data.publishedAt.toISOString()}>
                    {formatWritingDate(entry.data.publishedAt, locale)}
                  </time>
                  <span>{copy.filters[entry.data.language]}</span>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section id="writing-archive" class="archive" aria-labelledby="archive-title" data-writing-archive>
      <header class="section-heading">
        <div>
          <p class="eyebrow"><span></span>{copy.latest.label}</p>
          <h2 id="archive-title">{copy.latest.title}</h2>
        </div>
        <p>{copy.latest.intro}</p>
      </header>

      {
        entries.length > 0 ? (
          <>
            <div class="filters" aria-label={copy.filters.label}>
              <button class="is-active" type="button" data-language-filter="all">
                {copy.filters.all}
              </button>
              <button type="button" data-language-filter="id">{copy.filters.id}</button>
              <button type="button" data-language-filter="en">{copy.filters.en}</button>
            </div>

            <div class="writing-list">
              {entries.map((entry) => (
                <WritingCard entry={entry} locale={locale} />
              ))}
            </div>

            <p class="filter-empty" data-filter-empty hidden>{copy.filters.empty}</p>
          </>
        ) : (
          <div class="archive-empty">
            <strong>{copy.latest.emptyTitle}</strong>
            <p>{copy.latest.emptyBody}</p>
          </div>
        )
      }
    </section>

    <section id="writing-topics" class="topics" aria-labelledby="topics-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow"><span></span>{copy.topics.label}</p>
          <h2 id="topics-title">{copy.topics.title}</h2>
        </div>
        <p>{copy.topics.intro}</p>
      </header>

      {
        topics.length > 0 ? (
          <div class="topic-grid">
            {topics.map((topic) => (
              <a class="topic-card" href={getTopicPath(topic.segments, locale)}>
                <h3>{getTopicLabel(topic.segments.at(-1)!, locale)}</h3>
                <p>
                  {topic.count} {copy.topics.article}
                </p>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        ) : (
          <p class="topic-empty">{copy.topics.empty}</p>
        )
      }
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .writing-hero,
  .section-heading,
  .featured-grid,
  .topic-grid,
  .topic-empty,
  .filters,
  .writing-list,
  .filter-empty,
  .archive-empty {
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .writing-hero {
    display: grid;
    min-height: min(44rem, calc(100svh - 4.25rem));
    padding: 3.5rem var(--page-pad) 2rem;
    grid-template-rows: 1fr auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    width: 1rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--accent);
  }

  .hero-grid {
    display: grid;
    align-self: center;
    gap: 1.75rem;
  }

  h1 {
    display: grid;
    margin: 0;
    font-size: clamp(3.3rem, 16vw, 7rem);
    line-height: 0.82;
    letter-spacing: -0.085em;
  }

  h1 em {
    color: var(--accent);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .hero-grid > p,
  .section-heading > p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .featured,
  .topics,
  .archive {
    padding: 5rem var(--page-pad);
  }

  .featured {
    background: var(--ink);
    color: #fff;
  }

  .featured .eyebrow,
  .featured .section-heading > p {
    color: #bdbdbd;
  }

  .topics {
    background: var(--paper);
  }

  .archive {
    background: #fff;
  }

  .section-heading {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  h2 {
    max-width: 39rem;
    margin: 0.75rem 0 0;
    font-size: clamp(2.55rem, 12vw, 5.6rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .featured-grid {
    display: grid;
    gap: 0.75rem;
  }

  .featured-card {
    position: relative;
    display: flex;
    min-height: 17rem;
    flex-direction: column;
    padding: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    background: #171717;
    transition:
      border-radius var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .featured-card:hover,
  .featured-card:focus-visible {
    border-color: var(--accent);
    border-radius: 2.25rem;
    transform: translateY(-0.25rem);
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: #bdbdbd;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .featured-card h3 {
    max-width: 31rem;
    margin: auto 0 0;
    font-size: clamp(2rem, 9vw, 3.5rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .featured-card > p {
    max-width: 31rem;
    margin: 1rem 2.5rem 0 0;
    color: #bdbdbd;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .featured-card i {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    color: var(--accent);
    font-style: normal;
  }

  .topic-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .topic-card {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    height: 6.5rem;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 2.8rem 1rem 1rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
    transition:
      border-radius var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .topic-card:nth-child(3n + 2) {
    background: var(--electric);
    color: var(--ink);
  }

  .topic-card:nth-child(3n + 3) {
    background: var(--accent);
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    border-radius: 2.25rem;
    transform: translateY(-0.25rem);
  }

  .topic-card p {
    font-size: 0.65rem;
    font-weight: 800;
  }

  .topic-card h3 {
    margin: 0;
    font-size: clamp(1.15rem, 5vw, 1.7rem);
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .topic-card p {
    margin: 0.5rem 0 0;
    opacity: 0.7;
    text-transform: uppercase;
  }

  .topic-card i {
    position: absolute;
    top: 50%;
    right: 1rem;
    font-style: normal;
    transform: translateY(-50%);
  }

  .topic-empty,
  .archive-empty {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.78rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  .filters button {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.63rem;
    font-weight: 800;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease);
  }

  .filters button:hover,
  .filters button:focus-visible,
  .filters button.is-active {
    background: var(--ink);
    color: #fff;
  }

  .filter-empty {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .archive-empty strong {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ink);
    font-size: 1.2rem;
  }

  .archive-empty p {
    max-width: 31rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .hero-grid,
    .section-heading {
      align-items: end;
      grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.75fr);
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-card:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-writing-archive]").forEach((archive) => {
    const buttons = archive.querySelectorAll<HTMLButtonElement>("[data-language-filter]");
    const entries = archive.querySelectorAll<HTMLElement>("[data-writing-entry]");
    const empty = archive.querySelector<HTMLElement>("[data-filter-empty]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const language = button.dataset.languageFilter ?? "all";
        let visibleCount = 0;

        buttons.forEach((item) => item.classList.toggle("is-active", item === button));
        entries.forEach((entry) => {
          const visible = language === "all" || entry.dataset.language === language;
          entry.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (empty) empty.hidden = visibleCount > 0;
      });
    });
  });
</script>

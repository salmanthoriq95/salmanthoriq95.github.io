---
import { defaultLocale, type Locale } from "../i18n";
import { ui } from "../i18n/ui";
import {
  formatWritingDate,
  getDirectChildTopics,
  getPublishedWriting,
  getWritingPath,
} from "../lib/writing";
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroScrollCue from "./HeroScrollCue.astro";
import SectionHeading from "./SectionHeading.astro";
import TopicCards from "./TopicCards.astro";
import WritingList from "./WritingList.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = ui[locale].writing;
const entries = await getPublishedWriting();
const featuredEntries = entries.filter((entry) => entry.data.featured);
const topics = getDirectChildTopics(entries);
const firstSectionPath = featuredEntries.length > 0 ? "#featured-writing" : "#writing-archive";
---

<SiteLayout locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <main>
    <section class="writing-hero" aria-labelledby="writing-title">
      <div class="hero-grid">
        <h1 id="writing-title">
          <em>{copy.hero.emphasis}</em>
          <span>{copy.hero.title}</span>
        </h1>
        <p>{copy.hero.intro}</p>
      </div>

      <HeroScrollCue href={firstSectionPath} label={copy.hero.count} />
    </section>

    {
      featuredEntries.length > 0 && (
        <section id="featured-writing" class="featured" aria-labelledby="featured-title">
          <SectionHeading
            label={copy.featured.label}
            title={copy.featured.title}
            intro={copy.featured.intro}
            titleId="featured-title"
            inverse
          />

          <div class="featured-grid">
            {featuredEntries.map((entry) => (
              <a class="featured-card" href={getWritingPath(entry, locale)}>
                <div class="featured-meta">
                  <time datetime={entry.data.publishedAt.toISOString()}>
                    {formatWritingDate(entry.data.publishedAt, locale)}
                  </time>
                  <span>{copy.filters[entry.data.language]}</span>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <i aria-hidden="true">↗</i>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section id="writing-archive" class="archive" aria-labelledby="archive-title">
      <SectionHeading
        label={copy.latest.label}
        title={copy.latest.title}
        intro={copy.latest.intro}
        titleId="archive-title"
      />

      {
        entries.length > 0 ? (
          <>
            <WritingList entries={entries} locale={locale} />
          </>
        ) : (
          <div class="archive-empty">
            <strong>{copy.latest.emptyTitle}</strong>
            <p>{copy.latest.emptyBody}</p>
          </div>
        )
      }
    </section>

    <section id="writing-topics" class="topics" aria-labelledby="topics-title">
      <SectionHeading
        label={copy.topics.label}
        title={copy.topics.title}
        intro={copy.topics.intro}
        titleId="topics-title"
      />

      {
        topics.length > 0 ? (
          <TopicCards topics={topics} locale={locale} articleLabel={copy.topics.article} />
        ) : (
          <p class="topic-empty">{copy.topics.empty}</p>
        )
      }
    </section>
  </main>

</SiteLayout>

<style>
  .writing-hero,
  .featured-grid,
  .topic-empty,
  .archive-empty {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .writing-hero {
    display: grid;
    min-height: min(44rem, calc(100svh - 4.25rem));
    padding: 3.5rem var(--page-pad) 2rem;
    grid-template-rows: 1fr auto;
  }

  .hero-grid {
    display: grid;
    align-self: center;
    gap: 1.75rem;
  }

  h1 {
    display: grid;
    margin: 0;
    font-size: clamp(3.3rem, 16vw, 7rem);
    line-height: 0.82;
    letter-spacing: -0.085em;
  }

  h1 em {
    color: var(--accent);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .hero-grid > p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .featured,
  .topics,
  .archive {
    padding: 5rem var(--page-pad);
  }

  .featured {
    background: var(--ink);
    color: #fff;
  }

  .topics {
    background: var(--paper);
  }

  .archive {
    background: #fff;
  }

  .featured-grid {
    display: grid;
    gap: 0.75rem;
  }

  .featured-card {
    position: relative;
    display: flex;
    min-height: 17rem;
    flex-direction: column;
    padding: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    background: #171717;
    transition:
      border-radius var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .featured-card:hover,
  .featured-card:focus-visible {
    border-color: var(--accent);
    border-radius: 2.25rem;
    transform: translateY(-0.25rem);
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: #bdbdbd;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .featured-card h3 {
    max-width: 31rem;
    margin: auto 0 0;
    font-size: clamp(2rem, 9vw, 3.5rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .featured-card > p {
    max-width: 31rem;
    margin: 1rem 2.5rem 0 0;
    color: #bdbdbd;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .featured-card i {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    color: var(--accent);
    font-style: normal;
  }

  .topic-empty,
  .archive-empty {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.78rem;
  }

  .archive-empty strong {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ink);
    font-size: 1.2rem;
  }

  .archive-empty p {
    max-width: 31rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .hero-grid {
      align-items: end;
      grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.75fr);
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-card:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>

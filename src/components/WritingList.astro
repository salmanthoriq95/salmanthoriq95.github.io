---
import { type WritingEntry } from "../lib/writing";
import WritingCard from "./WritingCard.astro";

interface Props {
  entries: WritingEntry[];
}

const { entries } = Astro.props;
---

<div class="writing-list-shell">
  <div class="writing-list">
    {entries.map((entry) => <WritingCard entry={entry} />)}
  </div>
</div>

<style>
  .writing-list-shell {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

</style>

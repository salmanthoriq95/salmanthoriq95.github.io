---
import { defaultLocale, getLocalizedPath, type Locale } from "../i18n";
import { ui } from "../i18n/ui";
import {
  getDirectChildTopics,
  getPublishedWriting,
  getTopicLabel,
  getTopicPath,
  isEntryInTopic,
} from "../lib/writing";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import WritingCard from "./WritingCard.astro";

interface Props {
  locale?: Locale;
  topic: string;
}

const { locale = defaultLocale, topic } = Astro.props;
const copy = ui[locale].writing;
const segments = topic.split("/").filter(Boolean);
const allEntries = await getPublishedWriting();
const entries = allEntries.filter((entry) => isEntryInTopic(entry, segments));
const childTopics = getDirectChildTopics(allEntries, segments);
const topicTitle = getTopicLabel(segments.at(-1) ?? topic, locale);
const writingPath = getLocalizedPath(locale, "/writing");
---

<BaseLayout
  locale={locale}
  title={`${topicTitle} — ${copy.meta.title}`}
  description={copy.topic.intro}
>
  <Header locale={locale} />

  <main>
    <section class="topic-articles" aria-labelledby="articles-title" data-writing-archive>
      <header class="topic-header">
        <nav class="topic-breadcrumb" aria-label={copy.article.topics}>
          <span class="breadcrumb-line" aria-hidden="true"></span>
          <a href={writingPath}>{copy.topic.back}</a>
          {segments.map((segment, index) => (
            <>
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
              <a
                href={getTopicPath(segments.slice(0, index + 1), locale)}
                aria-current={index === segments.length - 1 ? "page" : undefined}
              >
                {getTopicLabel(segment, locale)}
              </a>
            </>
          ))}
        </nav>

        <div class="topic-heading">
          <h1 id="articles-title">{topicTitle}<span>.</span></h1>
          <p>{copy.topic.intro}</p>
        </div>
      </header>

      <div class="filters" aria-label={copy.filters.label}>
        <button class="is-active" type="button" data-language-filter="all">
          {copy.filters.all}
        </button>
        <button type="button" data-language-filter="id">{copy.filters.id}</button>
        <button type="button" data-language-filter="en">{copy.filters.en}</button>
      </div>

      <div class="writing-list">
        {entries.map((entry) => (
          <WritingCard entry={entry} locale={locale} />
        ))}
      </div>

      <p class="filter-empty" data-filter-empty hidden>{copy.filters.empty}</p>
    </section>

    {
      childTopics.length > 0 && (
        <section class="subtopics" aria-labelledby="subtopics-title">
          <div class="subtopic-inner">
            <p class="eyebrow"><span></span>{copy.topics.childLabel}</p>
            <h2 id="subtopics-title">{copy.topics.title}</h2>
            <div class="subtopic-list">
              {childTopics.map((child) => (
                <a href={getTopicPath(child.segments, locale)}>
                  <strong>{getTopicLabel(child.segments.at(-1)!, locale)}</strong>
                  <span>{child.count} {copy.topics.article}</span>
                  <i aria-hidden="true">↗</i>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .topic-header,
  .filters,
  .writing-list,
  .filter-empty,
  .subtopic-inner {
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .topic-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .breadcrumb-line {
    width: 1rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--accent);
  }

  .topic-breadcrumb a {
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .topic-breadcrumb a:hover,
  .topic-breadcrumb a:focus-visible,
  .topic-breadcrumb a[aria-current="page"] {
    color: var(--ink);
  }

  .breadcrumb-separator {
    color: var(--accent);
  }

  .topic-heading {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 3.5rem;
  }

  h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(2.8rem, 13vw, 5rem);
    line-height: 0.88;
    letter-spacing: -0.08em;
  }

  h1 span {
    color: var(--accent);
  }

  .topic-heading > p {
    max-width: 27rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .subtopics,
  .topic-articles {
    padding: 5rem max(var(--page-pad), calc((100vw - 52rem) / 2));
  }

  .topic-articles {
    background: #fff;
  }

  .subtopics {
    background: var(--ink);
    color: #fff;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    width: 1rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--accent);
  }

  .subtopics .eyebrow {
    color: #bdbdbd;
  }

  h2 {
    max-width: 42rem;
    margin: 0.75rem 0 2.5rem;
    font-size: clamp(2.55rem, 12vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .subtopic-list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .subtopic-list a {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    height: 6.5rem;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 2.8rem 1rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    background: #191919;
    transition:
      border-radius var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .subtopic-list a:nth-child(3n + 2) {
    border-color: transparent;
    background: var(--electric);
    color: var(--ink);
  }

  .subtopic-list a:nth-child(3n + 3) {
    border-color: transparent;
    background: var(--accent);
  }

  .subtopic-list a:hover,
  .subtopic-list a:focus-visible {
    border-color: var(--accent);
    border-radius: 2.25rem;
    transform: translateY(-0.25rem);
  }

  .subtopic-list strong {
    display: block;
    font-size: clamp(1.15rem, 5vw, 1.7rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .subtopic-list span {
    display: block;
    margin-top: 0.5rem;
    color: #bdbdbd;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .subtopic-list a:nth-child(3n + 2) span {
    color: rgba(7, 7, 7, 0.65);
  }

  .subtopic-list i {
    position: absolute;
    top: 50%;
    right: 1rem;
    font-style: normal;
    transform: translateY(-50%);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  .filters button {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.63rem;
    font-weight: 800;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease);
  }

  .filters button:hover,
  .filters button:focus-visible,
  .filters button.is-active {
    background: var(--ink);
    color: #fff;
  }

  .filter-empty {
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (min-width: 48rem) {
    .topic-heading {
      align-items: end;
      grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.75fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-writing-archive]").forEach((archive) => {
    const buttons = archive.querySelectorAll<HTMLButtonElement>("[data-language-filter]");
    const entries = archive.querySelectorAll<HTMLElement>("[data-writing-entry]");
    const empty = archive.querySelector<HTMLElement>("[data-filter-empty]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const language = button.dataset.languageFilter ?? "all";
        let visibleCount = 0;

        buttons.forEach((item) => item.classList.toggle("is-active", item === button));
        entries.forEach((entry) => {
          const visible = language === "all" || entry.dataset.language === language;
          entry.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (empty) empty.hidden = visibleCount > 0;
      });
    });
  });
</script>

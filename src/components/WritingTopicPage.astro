---
import { defaultLocale, type Locale } from "../i18n";
import { ui } from "../i18n/ui";
import {
  getDirectChildTopics,
  getPublishedWriting,
  getTopicLabel,
  isEntryInTopic,
} from "../lib/writing";
import SiteLayout from "../layouts/SiteLayout.astro";
import TopicCards from "./TopicCards.astro";
import WritingBreadcrumb from "./WritingBreadcrumb.astro";
import WritingList from "./WritingList.astro";

interface Props {
  locale?: Locale;
  topic: string;
}

const { locale = defaultLocale, topic } = Astro.props;
const copy = ui[locale].writing;
const segments = topic.split("/").filter(Boolean);
const allEntries = await getPublishedWriting();
const entries = allEntries.filter((entry) => isEntryInTopic(entry, segments));
const childTopics = getDirectChildTopics(allEntries, segments);
const topicTitle = getTopicLabel(segments.at(-1) ?? topic);
---

<SiteLayout
  locale={locale}
  title={`${topicTitle} — ${copy.meta.title}`}
  description={copy.topic.intro}
>
  <main>
    <section class="topic-articles" aria-labelledby="articles-title">
      <header class="topic-header">
        <WritingBreadcrumb
          locale={locale}
          segments={segments}
          rootLabel={copy.topic.back}
          ariaLabel={copy.article.topics}
          markCurrent
        />

        <div class="topic-heading">
          <h1 id="articles-title">{topicTitle}<span>.</span></h1>
          <p>{copy.topic.intro}</p>
        </div>
      </header>

      <WritingList entries={entries} locale={locale} />
    </section>

    {
      childTopics.length > 0 && (
        <section class="subtopics" aria-labelledby="subtopics-title">
          <div class="subtopic-inner">
            <p class="eyebrow eyebrow--inverse"><span></span>{copy.topics.childLabel}</p>
            <h2 id="subtopics-title">{copy.topics.title}</h2>
            <TopicCards
              topics={childTopics}
              locale={locale}
              articleLabel={copy.topics.article}
              inverse
            />
          </div>
        </section>
      )
    }
  </main>

</SiteLayout>

<style>
  .topic-header,
  .subtopic-inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .topic-heading {
    display: grid;
    gap: 1.5rem;
    margin: 3rem 0 3.5rem;
  }

  h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(2.8rem, 13vw, 5rem);
    line-height: 0.88;
    letter-spacing: -0.08em;
  }

  h1 span {
    color: var(--accent);
  }

  .topic-heading > p {
    max-width: 27rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .subtopics,
  .topic-articles {
    padding: 5rem max(var(--page-pad), calc((100vw - var(--content-width)) / 2));
  }

  .topic-articles {
    background: #fff;
  }

  .subtopics {
    background: var(--ink);
    color: #fff;
  }

  h2 {
    max-width: 42rem;
    margin: 0.75rem 0 2.5rem;
    font-size: clamp(2.55rem, 12vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  @media (min-width: 48rem) {
    .topic-heading {
      align-items: end;
      grid-template-columns: minmax(0, 1.5fr) minmax(14rem, 0.75fr);
    }
  }
</style>

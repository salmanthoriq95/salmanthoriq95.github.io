---
import "../styles/global.css";
import { site } from "../data/site";
import { ui } from "../data/ui";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = ui.meta.title,
  description = ui.meta.description,
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const sitemapURL = Astro.site
  ? new URL("sitemap-index.xml", Astro.site)
  : "/sitemap-index.xml";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author.fullName} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f2f2ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={sitemapURL} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=4" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initializeHorizontalDrag } from "../scripts/horizontalDrag";
      import { initializeSmoothDetails } from "../scripts/smoothDetails";

      initializeHorizontalDrag();
      initializeSmoothDetails();
    </script>
  </body>
</html>

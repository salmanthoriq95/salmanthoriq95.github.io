---
import "../styles/global.css";
import {
  defaultLocale,
  getLocalizedPath,
  supportedLocales,
  type Locale,
} from "../i18n";
import { ui } from "../i18n/ui";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  noindex?: boolean;
}

const {
  title = ui[defaultLocale].meta.title,
  description = ui[defaultLocale].meta.description,
  locale = defaultLocale,
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const localeURLs = supportedLocales.map((supportedLocale) => ({
  locale: supportedLocale,
  url: Astro.site
    ? new URL(getLocalizedPath(supportedLocale, Astro.url.pathname), Astro.site)
    : getLocalizedPath(supportedLocale, Astro.url.pathname),
}));
const defaultURL = Astro.site
  ? new URL(getLocalizedPath(defaultLocale, Astro.url.pathname), Astro.site)
  : getLocalizedPath(defaultLocale, Astro.url.pathname);
const sitemapURL = Astro.site
  ? new URL("sitemap-index.xml", Astro.site)
  : "/sitemap-index.xml";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author.fullName} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f2f2ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalURL} />
    {localeURLs.map(({ locale: alternateLocale, url }) => (
      <link rel="alternate" hreflang={alternateLocale} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultURL} />
    <link rel="sitemap" href={sitemapURL} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=4" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initializeHorizontalDrag } from "../scripts/horizontalDrag";
      import { initializeSmoothDetails } from "../scripts/smoothDetails";

      initializeHorizontalDrag();
      initializeSmoothDetails();
    </script>
  </body>
</html>

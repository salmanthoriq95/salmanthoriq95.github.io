---
import "../styles/global.css";
import {
  defaultLocale,
  getLocalizedPath,
  supportedLocales,
  type Locale,
} from "../i18n";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = "Salman Thoriq — Personal Portfolio",
  description = "Experience, selected projects, and writing by Salman Thoriq.",
  locale = defaultLocale,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const localeURLs = supportedLocales.map((supportedLocale) => ({
  locale: supportedLocale,
  url: Astro.site
    ? new URL(getLocalizedPath(supportedLocale, Astro.url.pathname), Astro.site)
    : getLocalizedPath(supportedLocale, Astro.url.pathname),
}));
const defaultURL = Astro.site
  ? new URL(getLocalizedPath(defaultLocale, Astro.url.pathname), Astro.site)
  : getLocalizedPath(defaultLocale, Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Salman Thoriq Al Farisyi" />
    <meta name="theme-color" content="#f2f2ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalURL} />
    {localeURLs.map(({ locale: alternateLocale, url }) => (
      <link rel="alternate" hreflang={alternateLocale} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  noindex = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <Header />
  <slot />
  <ScrollToTop />
  <Footer />
</BaseLayout>

---
import { site } from "../data/site";
import {
  defaultLocale,
  getLocalizedPath,
  supportedLocales,
} from "../i18n";
import { ui } from "../i18n/ui";
import SiteLayout from "../layouts/SiteLayout.astro";

const copy = ui[defaultLocale].notFound;
const year = new Date().getFullYear();
const localeConfig = Object.fromEntries(
  supportedLocales.map((locale) => [
    locale,
    {
      page: ui[locale].notFound,
      navigation: {
        ...ui[locale].navigation,
        homePath: getLocalizedPath(locale),
        links: ui[locale].navigation.links.map((link) => ({
          ...link,
          href: getLocalizedPath(locale, link.path),
        })),
      },
      footer: {
        ...ui[locale].footer,
        languagePickerLabel: ui[locale].language.label,
        copyright: `© ${year} ${site.author.shortName} · ${ui[locale].footer.archive}`,
      },
    },
  ]),
);
---

<SiteLayout
  locale={defaultLocale}
  title={copy.meta.title}
  description={copy.meta.description}
  noindex
>
  <main class="not-found" data-locale-config={JSON.stringify(localeConfig)}>
    <section class="error-content" aria-labelledby="error-title">
      <div class="error-number" aria-label={copy.code}>
        <span data-error-number data-final-number={copy.code} aria-hidden="true">{copy.code}</span><em aria-hidden="true">.</em>
      </div>

      <div class="message-grid">
        <h1 id="error-title" data-page-copy="title">{copy.title}</h1>

        <div class="message-copy">
          <p data-page-copy="description">{copy.description}</p>
          <a class="home-button" href={getLocalizedPath(defaultLocale)} data-home-link>
            <span data-page-copy="homeCta">{copy.homeCta}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

</SiteLayout>

<style>
  .not-found {
    background: var(--paper);
  }

  .error-content {
    display: grid;
    width: 100%;
    max-width: var(--content-width);
    min-height: min(44rem, calc(100svh - 4.25rem));
    margin-inline: auto;
    padding: 4rem var(--page-pad);
    place-content: center;
  }

  .error-number {
    display: flex;
    align-items: baseline;
    justify-self: center;
    font-size: clamp(7rem, 36vw, 15rem);
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    line-height: 0.7;
    letter-spacing: -0.11em;
  }

  .error-number span {
    display: inline-block;
    min-width: 2.7ch;
    text-align: right;
  }

  .error-number em {
    color: var(--accent);
    font-style: normal;
  }

  .message-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 5rem;
  }

  h1 {
    max-width: 31rem;
    margin: 0;
    font-size: clamp(2.4rem, 12vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .message-copy {
    display: grid;
    align-content: end;
    gap: 1.5rem;
  }

  .message-copy p {
    max-width: 25rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .home-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: fit-content;
    min-width: 13rem;
    padding: 0.65rem 0.7rem 0.65rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.67rem;
    font-weight: 800;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .home-button:hover,
  .home-button:focus-visible {
    background: var(--night);
    transform: translateX(0.2rem);
  }

  .home-button > span:last-child {
    margin-left: 1rem;
  }

  @media (min-width: 48rem) {
    .error-content {
      padding-block: 6rem;
    }

    .error-number {
      font-size: clamp(11rem, 18vw, 15rem);
    }

    .message-grid {
      align-items: end;
      grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
      gap: 3rem;
    }
  }
</style>

<script>
  type PageCopyKey = "code" | "title" | "description" | "homeCta";

  const page = document.querySelector<HTMLElement>("[data-locale-config]");
  const configs = JSON.parse(page?.dataset.localeConfig ?? "{}") as Record<string, {
    page: {
      meta: { title: string; description: string };
      code: string;
      title: string;
      description: string;
      homeCta: string;
    };
    navigation: {
      label: string;
      homeLabel: string;
      homePath: string;
      links: Array<{ label: string; href: string }>;
    };
    footer: Record<string, string>;
  }>;
  const locale = /^\/id(?:\/|$)/.test(window.location.pathname) ? "id" : "en";
  const config = configs[locale];
  const number = document.querySelector<HTMLElement>("[data-error-number]");

  if (config) {
    document.documentElement.lang = locale;
    document.title = config.page.meta.title;

    document.querySelectorAll<HTMLElement>("[data-page-copy]").forEach((element) => {
      const key = element.dataset.pageCopy as PageCopyKey;
      element.textContent = config.page[key] ?? element.textContent;
    });

    if (number) {
      number.textContent = config.page.code;
      number.dataset.finalNumber = config.page.code;
      number.parentElement?.setAttribute("aria-label", config.page.code);
    }

    document.querySelectorAll<HTMLAnchorElement>("[data-home-link]").forEach((link) => {
      link.href = config.navigation.homePath;
    });

    const headerBrand = document.querySelector<HTMLAnchorElement>(".site-header .brand");
    if (headerBrand) {
      headerBrand.href = config.navigation.homePath;
      headerBrand.ariaLabel = config.navigation.homeLabel;
    }

    const navigation = document.querySelector<HTMLElement>(".site-header nav");
    if (navigation) navigation.ariaLabel = config.navigation.label;

    document.querySelectorAll<HTMLAnchorElement>(".site-header nav a").forEach((link, index) => {
      const item = config.navigation.links[index];
      if (!item) return;
      link.textContent = item.label;
      link.href = item.href;
    });

    document.querySelectorAll<HTMLElement>("[data-footer-copy]").forEach((element) => {
      const key = element.dataset.footerCopy ?? "";
      element.textContent = config.footer[key] ?? element.textContent;
    });

    const languageName = document.querySelector<HTMLElement>("[data-footer-language-name]");
    if (languageName) languageName.textContent = config.footer.languageName;

    const languageOptions = document.querySelector<HTMLElement>(".language-options");
    if (languageOptions) languageOptions.ariaLabel = config.footer.languagePickerLabel;

    const contactWord = document.querySelector<HTMLAnchorElement>("[data-footer-contact-word]");
    if (contactWord) {
      contactWord.textContent = config.footer.contactWord;
      contactWord.ariaLabel = config.footer.emailLabel;
    }

    const copyright = document.querySelector<HTMLElement>("[data-footer-copyright]");
    if (copyright) copyright.textContent = config.footer.copyright;

    const pathWithoutLocale = window.location.pathname.replace(/^\/id(?=\/|$)/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>(".language-options a[data-locale]").forEach((link) => {
      const targetLocale = link.dataset.locale ?? "en";
      link.href = targetLocale === "en"
        ? pathWithoutLocale
        : pathWithoutLocale === "/"
          ? "/id/"
          : `/id${pathWithoutLocale}`;
      if (targetLocale === locale) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });

    const description = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    if (description) description.content = config.page.meta.description;

    const openGraphTitle = document.querySelector<HTMLMetaElement>('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.content = config.page.meta.title;

    const openGraphDescription = document.querySelector<HTMLMetaElement>('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.content = config.page.meta.description;
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (number && !reduceMotion) {
    const finalNumber = number.dataset.finalNumber ?? "";
    const duration = 1000;
    const interval = 70;
    const startedAt = performance.now();

    const scramble = window.setInterval(() => {
      number.textContent = Array.from({ length: finalNumber.length }, () =>
        Math.floor(Math.random() * 10),
      ).join("");

      if (performance.now() - startedAt >= duration) {
        window.clearInterval(scramble);
        number.textContent = finalNumber;
      }
    }, interval);
  }
</script>

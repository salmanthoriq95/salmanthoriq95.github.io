---
import WritingTopicPage from "../../../../components/WritingTopicPage.astro";
import { getAllTopicPaths, getPublishedWriting } from "../../../../lib/writing";

export async function getStaticPaths() {
  const entries = await getPublishedWriting();

  return getAllTopicPaths(entries).map((segments) => ({
    params: { topic: segments.join("/") },
    props: { topic: segments.join("/") },
  }));
}

interface Props {
  topic: string;
}

const { topic } = Astro.props;
---

<WritingTopicPage locale="en" topic={topic} />

---
import WritingArticlePage from "../../components/WritingArticlePage.astro";
import {
  getPublishedWriting,
  getWritingSlug,
  type WritingEntry,
} from "../../lib/writing";

export async function getStaticPaths() {
  const entries = await getPublishedWriting();

  return entries.map((entry) => ({
    params: { slug: getWritingSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
---

<WritingArticlePage locale="id" entry={entry} />
